# PostgreSQL connection string (Render provides this when you create a Postgres instance)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET="replace-with-a-long-random-secret"

# Your deployed Vercel frontend URL, e.g. https://your-app.vercel.app
FRONTEND_URL="http://localhost:3000"

# Render sets PORT automatically; only needed for local dev
PORT=4000
